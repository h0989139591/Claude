{
  "template": "severance-agreement.template.md",
  "version": "1.0",
  "law_basis_date": "2026-10-18",
  "syntax": "mustache",
  "types": {
    "text": "原樣輸出",
    "date": "輸入 YYYY-MM-DD，輸出「民國115年10月31日（2026-10-31）」",
    "money": "輸入整數（元），輸出千分位，例如 27,500",
    "int": "整數",
    "boolean": "供 {{#x}}…{{/x}} 與 {{^x}}…{{/x}} 區段使用",
    "enum": "限定選項"
  },
  "inputs": [
    {"key": "company_name", "label": "公司簡稱", "type": "text", "required": true, "default": "元多淥行銷"},
    {"key": "company_full_name", "label": "公司登記全名", "type": "text", "required": true},
    {"key": "company_tax_id", "label": "統一編號", "type": "text", "required": true, "pattern": "^\\d{8}$"},
    {"key": "company_rep", "label": "公司代表人", "type": "text", "required": true},
    {"key": "company_address", "label": "公司地址", "type": "text", "required": true},
    {"key": "employee_name", "label": "員工姓名", "type": "text", "required": true},
    {"key": "employee_id_no", "label": "員工身分證字號", "type": "text", "required": true},
    {"key": "employee_address", "label": "員工地址", "type": "text", "required": true},
    {"key": "employee_phone", "label": "員工電話", "type": "text", "required": true},
    {"key": "job_title", "label": "職稱", "type": "text", "required": true},
    {"key": "hire_date", "label": "到職日", "type": "date", "required": true},
    {"key": "notice_date", "label": "預告日（通知資遣之日）", "type": "date", "required": true},
    {"key": "termination_date", "label": "離職日（勞動契約終止日）", "type": "date", "required": true, "help": "須晚於預告日；建議不少於預告日起算的法定預告天數，否則系統自動算出不足日數預告工資。"},
    {"key": "avg_wage", "label": "月平均工資", "type": "money", "required": true, "help": "勞基法第2條第4款：離職前6個月工資總額 ÷ 總日數 × 30。"},
    {"key": "monthly_wage", "label": "原領月薪（計算預告工資用）", "type": "money", "required": true, "default_from": "avg_wage"},
    {"key": "reason_clause", "label": "資遣事由（勞基法第11條第幾款）", "type": "enum", "options": [1, 2, 3, 4, 5], "required": true},
    {"key": "reason_detail", "label": "具體事實說明", "type": "text", "required": true},
    {"key": "review_received_date", "label": "乙方收到協議書日期", "type": "date", "required": true},
    {"key": "review_days", "label": "審閱期（日）", "type": "int", "required": true, "default": 3, "min": 3, "help": "建議至少 3 日。"},
    {"key": "bank_name", "label": "乙方收款銀行", "type": "text", "required": true},
    {"key": "bank_account", "label": "乙方收款帳號", "type": "text", "required": true},
    {"key": "unpaid_wage", "label": "至離職日止的未給工資", "type": "money", "required": true, "default": 0},
    {"key": "overtime_pay", "label": "加班費", "type": "money", "required": true, "default": 0},
    {"key": "comp_leave_pay", "label": "未補休折發工資", "type": "money", "required": true, "default": 0},
    {"key": "annual_leave_days_entitled", "label": "特休應有日數", "type": "text", "required": true},
    {"key": "annual_leave_days_used", "label": "特休已休日數", "type": "text", "required": true},
    {"key": "annual_leave_days_unused", "label": "特休未休日數", "type": "text", "required": true},
    {"key": "annual_leave_pay", "label": "未休特休折發工資", "type": "money", "required": true, "default": 0},
    {"key": "bonus_pay", "label": "約定獎金、分潤、代墊款", "type": "money", "required": true, "default": 0},
    {"key": "settlement_amount", "label": "第七條和解金", "type": "money", "required": true, "min": 1, "help": "和解須互相讓步；金額為 0 時斷尾條款可能因缺乏對價而被認定無效或顯失公平。"},
    {"key": "dispute_days", "label": "異議期間（日）", "type": "int", "required": true, "default": 7},
    {"key": "dispute_reply_days", "label": "公司覆核期間（日）", "type": "int", "required": true, "default": 7},
    {"key": "cure_days", "label": "勞退短繳補繳期限（日）", "type": "int", "required": true, "default": 7},
    {"key": "noncompete_enabled", "label": "是否約定離職後競業禁止", "type": "boolean", "required": true, "default": false},
    {"key": "noncompete_months", "label": "競業禁止期間（月）", "type": "int", "required_if": "noncompete_enabled", "max": 24},
    {"key": "noncompete_region", "label": "競業禁止區域", "type": "text", "required_if": "noncompete_enabled"},
    {"key": "noncompete_scope", "label": "競業禁止業務範圍", "type": "text", "required_if": "noncompete_enabled"},
    {"key": "noncompete_target", "label": "競業禁止對象", "type": "text", "required_if": "noncompete_enabled"},
    {"key": "noncompete_monthly_compensation", "label": "競業禁止每月補償金", "type": "money", "required_if": "noncompete_enabled", "help": "不得低於離職前最後一個月平均工資的 50%（施行細則第7條之3）。"},
    {"key": "enforce_option", "label": "強化執行力方式", "type": "enum", "options": ["notary", "mediation", "none"], "required": true, "default": "none"},
    {"key": "court_name", "label": "管轄地方法院（不含「臺灣」「地方法院」字樣）", "type": "text", "required": true, "help": "例：臺北、新北、臺中。"},
    {"key": "sign_date", "label": "立協議書日期", "type": "date", "required": true}
  ],
  "computed": [
    {"key": "tenure_text", "type": "text", "rule": "到職日至（離職日＋1日）的年月數，例如 1年8個月"},
    {"key": "severance_base_text", "type": "text", "rule": "新制基數＝年資月數 ÷ 24；整除時以分數顯示（如 5/6）"},
    {"key": "severance_pay", "type": "money", "rule": "avg_wage × 年資月數 ÷ 24，年資不足1個月以1個月計，上限 6 個月平均工資，四捨五入"},
    {"key": "notice_days_required", "type": "int", "rule": "年資 3個月以上未滿1年→10；1年以上未滿3年→20；3年以上→30；未滿3個月→0（勞基法第16條）"},
    {"key": "notice_days_given", "type": "int", "rule": "離職日 − 預告日（日）"},
    {"key": "notice_shortfall_days", "type": "int", "rule": "max(0, 法定預告日數 − 實際預告日數)"},
    {"key": "has_notice_shortfall", "type": "boolean", "rule": "notice_shortfall_days > 0"},
    {"key": "notice_wage", "type": "money", "rule": "round(monthly_wage ÷ 30 × 不足日數)"},
    {"key": "notification_deadline", "type": "date", "rule": "離職日 − 10 日（就業服務法第33條）"},
    {"key": "severance_deadline", "type": "date", "rule": "離職日 + 30 日（勞基法第17條、勞退條例第12條）"},
    {"key": "total_payable", "type": "money", "rule": "資遣費 + 預告工資 + 未給工資 + 加班費 + 補休折發 + 特休折發 + 獎金等（不含和解金）"},
    {"key": "noncompete_min_compensation", "type": "money", "rule": "round(avg_wage × 50%)"},
    {"key": "reason_box_1", "type": "text", "rule": "reason_clause = 1 → ☑，否則 ☐（reason_box_2 至 5 同理）"},
    {"key": "enforce_box_notary", "type": "text", "rule": "enforce_option = notary → ☑，否則 ☐"},
    {"key": "enforce_box_mediation", "type": "text", "rule": "enforce_option = mediation → ☑，否則 ☐"},
    {"key": "enforce_box_none", "type": "text", "rule": "enforce_option = none → ☑，否則 ☐"}
  ]
}
